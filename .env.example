# Copy to .env beside compose.yml (mode 600, never versioned). Only one relay per Signal account may run.
#
# The push token, random, readable by the app's user (10001) only:
#   install -d -m 0700 secrets
#   python3 -c "import secrets; print(secrets.token_hex(32))" > secrets/push_token
#   sudo chown 10001:10001 secrets/push_token && sudo chmod 0400 secrets/push_token
# n8n sends the same token as `Authorization: Bearer <token>` to http://moonie-signal:8080/signal/send.

# The tag of the app image that `docker compose up -d --build` builds from this checkout
MOONIE_SIGNAL_IMAGE=moonie-signal:local
# The registered Signal number, + and digits
MOONIE_SIGNAL_ACCOUNT=
# The n8n webhook that receives every allowed message, such as http://n8n:5678/webhook/<your-webhook-path>
MOONIE_SIGNAL_WEBHOOK_URL=
# Who may talk to the bot in direct messages, comma-separated: Signal uuids preferred over numbers
MOONIE_SIGNAL_WHITELIST_DIRECT=
# Allowed groups, comma-separated (group:<id>, raw base64 id or the REST group.<id> form)
MOONIE_SIGNAL_ALLOWED_GROUPS=
# Everyone who may be in an allowed group: every member, pending invite and the sender must be listed, or the bot
# ignores the group (uuids, numbers or PNI:<uuid>); empty serves no group
MOONIE_SIGNAL_WHITELIST_GROUPS=

# Optional settings: leave them empty for the defaults given in the README
# The webhook's bearer token: the file's path inside the container (mount it with a compose.override.yml)
MOONIE_SIGNAL_WEBHOOK_TOKEN_FILE=
# Seconds the webhook has to answer (5 to 600, default 120)
MOONIE_SIGNAL_WEBHOOK_SECONDS=
# Default text mode of replies and pushes: markdown (default), styled or normal
MOONIE_SIGNAL_TEXT_MODE=
# Attachment bytes per message, both directions (default 10485760)
MOONIE_SIGNAL_MAX_ATTACHMENT_BYTES=
# Largest push body in bytes (default 67108864)
MOONIE_HTTP_MAX_BODY_BYTES=
